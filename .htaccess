# JACOM CORE — Apache Configuration
# Compatible con Apache 2.4+

Options -Indexes -MultiViews
ServerSignature Off

# ── Rewrite Engine ──────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS en producción
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirigir www a sin www
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Servir archivos estáticos directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo lo demás va a index.php
  RewriteRule ^ index.php [L]
</IfModule>

# ── Proteger directorios sensibles ──────────────────────────────
<FilesMatch "^(config|logs|src)">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Bloquear acceso directo a archivos PHP internos
<FilesMatch "\.php$">
  <If "%{REQUEST_URI} !~ m#^/index\.php#">
    Order Allow,Deny
    Deny from all
  </If>
</FilesMatch>

# ── Bloquear archivos sensibles ──────────────────────────────────
<FilesMatch "\.(env|log|sql|sh|bak|git|htpasswd)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ── Headers de seguridad ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Cache para assets estáticos
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Sin cache para PHP
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# ── Compresión GZIP ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Tipos MIME ───────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/svg+xml svg
  AddType application/font-woff woff
  AddType application/font-woff2 woff2
  AddCharset UTF-8 .html .css .js .php
</IfModule>

# ── Página de error personalizada ────────────────────────────────
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php
ErrorDocument 500 /index.php
